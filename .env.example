# Copy this file to .env for local (non-Docker) development:
#   cp .env.example .env

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (used directly when running the app with `npm run start:dev`
# against `docker compose up postgres`; the `app` service in docker-compose.yml
# overrides this with the in-network `postgres` hostname).
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet_conversion
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet_conversion?schema=public

# RabbitMQ
RABBITMQ_USER=wallet
RABBITMQ_PASSWORD=wallet
RABBITMQ_URL=amqp://wallet:wallet@localhost:5672

# Messaging / outbox (Feature 4)
MESSAGING_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
EXECUTION_CONSUMER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
RABBITMQ_CONNECT_MAX_ATTEMPTS=5
RABBITMQ_RETRY_BASE_DELAY_MS=250
RABBITMQ_RETRY_MAX_DELAY_MS=5000
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=5000
RABBITMQ_CONSUMER_MAX_RETRIES=3

# Concurrent same Idempotency-Key: loser polls for winner's stored response (spec §9)
IDEMPOTENCY_IN_PROGRESS_WAIT_MS=2000
IDEMPOTENCY_IN_PROGRESS_POLL_MS=25
IDEMPOTENCY_CLEANUP_ENABLED=true
IDEMPOTENCY_RETENTION_HOURS=24
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000

# Fake exchange default outcome: SUCCESS | FAILURE | UNKNOWN
FAKE_EXCHANGE_MODE=SUCCESS
